# WeChat Personal Account Bridge for Memoh
# Based on @pinixai/weixin-bot
# This version builds entirely on host to avoid Docker network issues

FROM node:22-alpine

WORKDIR /app

# Copy pre-built node_modules (including compiled SDK)
COPY node_modules ./node_modules
COPY package.json tsconfig.json ./

# Copy pre-compiled dist (built on host)
COPY dist ./dist

# Create data directory for WeChat credentials
RUN mkdir -p /data/.weixin-bot

# Expose control port
EXPOSE 3000

# Run the bridge
CMD ["npm", "start"]
